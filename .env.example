# Server-side Environment Variables (Set in Netlify Dashboard under Site Configuration > Environment variables)
# IMPORTANT: Never commit actual API keys or prefix with VITE_

# Google Gemini API Key for AIRWISE AI Assistant (Server-side Netlify Function)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Central Pollution Control Board (CPCB / data.gov.in) API key
DATA_GOV_IN_API_KEY=

# Local development port (Express server if running backend independently)
PORT=5000
NODE_ENV=development
